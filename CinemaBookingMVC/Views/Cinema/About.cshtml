@{
    ViewData["Title"] = "About Cinema";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-primary">About Our Cinema</h2>
                <p class="lead mt-3">
                    Welcome to the <strong>Cinema Ticket Booking System</strong>. We offer state-of-the-art screens, premium surround sound, and comfortable seating for an exceptional movie experience.
                </p>
                <hr />
                <h5>Key Features:</h5>
                <ul>
                    <li>Real-time seat availability checking</li>
                    <li>Instant online booking and ticket status tracking</li>
                    <li>Supports multiple languages and genres</li>
                </ul>
                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-primary">Back to Booking List</a>
                    <a asp-action="BookTicket" class="btn btn-success">Book a Ticket Now</a>
                </div>
            </div>
        </div>
    </div>
</div>