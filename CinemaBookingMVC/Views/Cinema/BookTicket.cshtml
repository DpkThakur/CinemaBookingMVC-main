@model CinemaBookingMVC.Models.Booking
@{
    ViewData["Title"] = "Book Ticket";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Book Movie Ticket</h4>
            </div>
            <div class="card-body">
                <form asp-action="BookTicket" asp-controller="Cinema" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label"></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" placeholder="Phone number" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MovieId" class="form-label"></label>
                            <select asp-for="MovieId" asp-items="ViewBag.MovieList" class="form-select">
                                <option value="">-- Select Movie --</option>
                            </select>
                            <span asp-validation-for="MovieId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="BookingDate" class="form-label"></label>
                            <input asp-for="BookingDate" class="form-control" type="date" />
                            <span asp-validation-for="BookingDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ShowDate" class="form-label"></label>
                            <input asp-for="ShowDate" class="form-control" type="date" />
                            <span asp-validation-for="ShowDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NumberOfTickets" class="form-label"></label>
                        <input asp-for="NumberOfTickets" class="form-control" type="number" min="1" max="10" />
                        <span asp-validation-for="NumberOfTickets" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <button type="submit" class="btn btn-success">Confirm Booking</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>